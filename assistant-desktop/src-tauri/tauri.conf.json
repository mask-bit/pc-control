{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Control AI",
  "version": "0.1.0",
  "identifier": "br.com.pccontrol.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:llama && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PC Control AI",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "externalBin": ["binaries/llama-server"],
    "resources": ["resources/bin/**/*", "resources/prompts/**/*"],
    "shortDescription": "Assistente local para controlar o PC",
    "longDescription": "Aplicativo desktop em portugues-BR para conversar com IA local, executar acoes comuns do Windows, controlar Spotify e criar rotinas."
  }
}
