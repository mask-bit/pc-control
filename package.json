{
  "name": "pc-control-ai",
  "private": true,
  "version": "0.1.0",
  "description": "PC Control AI: app Tauri/React para assistente local de PC no Windows.",
  "scripts": {
    "postinstall": "npm --prefix assistant-desktop install",
    "dev": "npm --prefix assistant-desktop run dev",
    "build:frontend": "npm --prefix assistant-desktop run build",
    "check:native": "npm --prefix assistant-desktop run check:native",
    "prepare:llama": "npm --prefix assistant-desktop run prepare:llama",
    "tauri:dev": "npm --prefix assistant-desktop run tauri:dev",
    "tauri:build": "npm --prefix assistant-desktop run tauri:build"
  }
}
